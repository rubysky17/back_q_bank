{
  "name": "back-q-bank",
  "version": "0.0.1",
  "description": "Question bank API (Hono on Cloudflare Workers + Drizzle + PostgreSQL)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.ts\" \"*.ts\" \"wrangler.jsonc\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:remote": "tsx scripts/seed.ts --remote",
    "db:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply DB --local && tsx scripts/seed.ts",
    "cf:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.7",
    "drizzle-kit": "0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "wrangler": "4.146.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261001.1": true
  },
  "engines": {
    "node": ">=22"
  }
}
