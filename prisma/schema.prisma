// Question bank schema. Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  HOST
  ADMIN
}

enum Platform {
  IOS
  ANDROID
  WEB
}

/// Only SINGLE_CHOICE has a handler for now; the others are reserved so adding them needs no enum migration.
enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  POINT_CHOICE
  DRAG_DROP
  CALCULATION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercased.
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sessions       Session[]
  topicsCreated  Topic[]
  domainsCreated Domain[]
  questions      Question[]
  exams          Exam[]
  attempts       Attempt[]
}

/// One row per signed-in device. The refresh token is `${id}.${secret}`; only sha256(secret) is stored.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash     String
  /// Previous secret, accepted for a short grace window after rotation (concurrent refreshes on mobile).
  prevSecretHash String?
  rotatedAt      DateTime? @db.Timestamptz(3)
  deviceId       String?
  deviceName     String?
  platform       Platform?
  userAgent      String?
  ip             String?
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  lastUsedAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, deviceId])
}

/// Shared across hosts (e.g. "PMP") so the catalog never shows duplicates.
model Topic {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  domains   Domain[]
  questions Question[]
  exams     Exam[]
}

/// Knowledge area inside a topic (PMP: People / Process / Business Environment). Tagged on questions, not on sections.
model Domain {
  id          String   @id @default(uuid(7)) @db.Uuid
  topicId     String   @db.Uuid
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  questions Question[]

  @@unique([topicId, name])
}

model Question {
  id          String       @id @default(uuid(7)) @db.Uuid
  ownerId     String       @db.Uuid
  owner       User         @relation(fields: [ownerId], references: [id])
  topicId     String       @db.Uuid
  topic       Topic        @relation(fields: [topicId], references: [id])
  domainId    String?      @db.Uuid
  domain      Domain?      @relation(fields: [domainId], references: [id])
  type        QuestionType @default(SINGLE_CHOICE)
  difficulty  Difficulty   @default(MEDIUM)
  /// Question stem (plain text / markdown).
  content     String
  explanation String?
  /// Type-specific payload, validated by the type's handler. SINGLE_CHOICE: { options: [{ id, content }], correctOptionId }.
  definition  Json
  /// Bumped on every edit; copied into attempts for per-version statistics.
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  examQuestions    ExamQuestion[]
  attemptQuestions AttemptQuestion[]

  @@index([ownerId, topicId])
  @@index([topicId, domainId, difficulty])
}

model Exam {
  id               String     @id @default(uuid(7)) @db.Uuid
  ownerId          String     @db.Uuid
  owner            User       @relation(fields: [ownerId], references: [id])
  topicId          String     @db.Uuid
  topic            Topic      @relation(fields: [topicId], references: [id])
  title            String
  description      String?
  status           ExamStatus @default(DRAFT)
  /// null = untimed.
  durationMinutes  Int?
  /// Pass mark in percent (0-100); null = no pass/fail.
  passingScore     Int?
  shuffleQuestions Boolean    @default(false)
  shuffleOptions   Boolean    @default(false)
  publishedAt      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  sections  ExamSection[]
  questions ExamQuestion[]
  attempts  Attempt[]

  @@index([ownerId])
  @@index([status, topicId])
}

/// Every exam has at least one section; an exam "without sections" simply has one.
model ExamSection {
  id           String   @id @default(uuid(7)) @db.Uuid
  examId       String   @db.Uuid
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title        String
  order        Int
  instructions String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  questions ExamQuestion[]

  /// Target of ExamQuestion's composite FK: guarantees a question's section belongs to the same exam.
  @@unique([id, examId])
  @@index([examId, order])
}

model ExamQuestion {
  id         String      @id @default(uuid(7)) @db.Uuid
  examId     String      @db.Uuid
  exam       Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId  String      @db.Uuid
  section    ExamSection @relation(fields: [sectionId, examId], references: [id, examId], onDelete: Cascade)
  questionId String      @db.Uuid
  question   Question    @relation(fields: [questionId], references: [id])
  order      Int
  points     Int         @default(1)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([examId, questionId])
  @@index([sectionId, order])
  @@index([questionId])
}

model Attempt {
  id             String        @id @default(uuid(7)) @db.Uuid
  examId         String        @db.Uuid
  exam           Exam          @relation(fields: [examId], references: [id])
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         AttemptStatus @default(IN_PROGRESS)
  /// Copied from the exam at start so history survives later edits.
  examTitle      String
  passingScore   Int?
  startedAt      DateTime      @default(now()) @db.Timestamptz(3)
  /// null = untimed.
  expiresAt      DateTime?     @db.Timestamptz(3)
  submittedAt    DateTime?     @db.Timestamptz(3)
  score          Int?
  maxScore       Int
  correctCount   Int?
  totalQuestions Int
  passed         Boolean?

  questions AttemptQuestion[]

  /// At most one in-progress attempt per user and exam.
  @@unique([userId, examId], map: "Attempt_one_in_progress_per_user_exam", where: raw("status = 'IN_PROGRESS'"))
  @@index([userId, startedAt])
  @@index([examId])
}

/// A question as it was when the attempt started (shuffled options, answer key, explanation).
model AttemptQuestion {
  id              String    @id @default(uuid(7)) @db.Uuid
  attemptId       String    @db.Uuid
  attempt         Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String?   @db.Uuid
  question        Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionVersion Int
  sectionId       String?   @db.Uuid
  sectionTitle    String
  sectionOrder    Int
  order           Int
  points          Int
  snapshot        Json
  response        Json?
  isCorrect       Boolean?
  score           Int?
  flagged         Boolean   @default(false)
  answeredAt      DateTime? @db.Timestamptz(3)

  @@unique([attemptId, order])
  @@index([questionId])
}
