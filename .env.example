NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# docker compose maps Postgres to localhost:5433
DATABASE_URL=postgresql://qbank:qbank@localhost:5433/qbank?schema=public

# At least 32 chars. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Per IP, applies to register/login/refresh
AUTH_RATE_LIMIT_PER_MINUTE=10

# Comma-separated browser origins (native mobile apps don't need CORS)
CORS_ORIGINS=http://localhost:8081
SWAGGER_ENABLED=true

# Used by `npx prisma db seed`
SEED_ADMIN_EMAIL=admin@qbank.local
SEED_ADMIN_PASSWORD=Admin@123456
