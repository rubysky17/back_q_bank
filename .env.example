# Copy to .env for local development. `wrangler dev` (npm run dev) and the seed script read it.
# In production set the same three secrets with `npx wrangler secret put <NAME>`.

# The only account that can sign in (single-account mode). Password: at least 12 characters.
ADMIN_EMAIL=admin@qbank.local
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Admin

# At least 32 chars. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Optional (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30
# Comma-separated browser origins (native mobile apps don't need CORS)
# CORS_ORIGINS=http://localhost:8081
