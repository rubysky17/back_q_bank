# Copy to .env for local development. `wrangler dev` (npm run dev) and the seed script read it.
# In production set JWT_ACCESS_SECRET with `npx wrangler secret put JWT_ACCESS_SECRET`.

# Read by the seed script only (not by the Worker): it creates or updates this ADMIN account in the
# User table with a hashed password. Password: at least 12 characters.
ADMIN_EMAIL=admin@qbank.local
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Admin

# At least 32 chars. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Optional (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30
# PBKDF2 cost of password hashes (10000–100000). 25000 fits the Free plan's 10 ms CPU per request.
# PASSWORD_HASH_ITERATIONS=25000
# Comma-separated browser origins (native mobile apps don't need CORS)
# CORS_ORIGINS=http://localhost:8081
